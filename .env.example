# Servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_invoice
DB_USER=root
DB_PASSWORD=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Módulo de vendedores: Google Sheets (/bill/api/vendedores)
GOOGLE_SHEETS_ID=
# Cuenta de servicio: comparte la hoja con este email como Editor
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Saint (solo lectura): documento con las pestañas Vendedor, Clientes e inventario (ID de su URL).
# Compártelo con GOOGLE_SERVICE_ACCOUNT_EMAIL como Lector. Vacío = el stock sale de la columna stock de Productos.
SAINT_SHEETS_ID=
SAINT_HOJA_INVENTARIO=inventario
SAINT_HOJA_VENDEDORES=Vendedor
# "si" para que Emitir factura descuente Productos.stock (nunca de los productos enlazados a Saint). Por defecto no.
DESCONTAR_INVENTARIO=no

# JWT de vendedores
JWT_SECRET=
JWT_EXPIRES_IN=7d
